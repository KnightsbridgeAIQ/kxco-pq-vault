{
  "name": "kxco-pq-vault",
  "version": "1.1.3",
  "description": "Post-quantum file and envelope encryption with ML-KEM-768 (FIPS 203). Encrypt to one recipient or many; each opens it with their own key. bech32m recipient strings, AES-256-GCM payloads.",
  "keywords": [
    "post-quantum",
    "encryption",
    "ml-kem",
    "kyber",
    "cli",
    "kxco",
    "pqc",
    "aes-gcm",
    "file-encryption",
    "envelope-encryption",
    "multi-recipient",
    "bech32m",
    "harvest-now-decrypt-later",
    "fips-203",
    "nist",
    "quantum-resistant"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-vault.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-vault/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "kxco-vault": "bin/kxco-vault.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "bin/",
    "src/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@scure/base": "2.3.0",
    "kxco-post-quantum": "^1.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --input-type=module --eval \"import('./src/cli.js')\" && echo lint ok"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
